{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_appName__",
  "version": "0.5.1",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://gitee.com/zuoqiuning/yuni-chaoxing-helper",
  "permissions": ["storage", "sidePanel", "tabs", "activeTab", "notifications"],
  "host_permissions": [
    "<all_urls>",
    "*://*.chaoxing.com/*",
    "https://api.xiaomimimo.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chaoxing.com/*"
      ],
      "js": [
        "content/utils.js",
        "content/selectors.js",
        "content/dom.js",
        "content/catalog.js",
        "content/jobs.js",
        "content/doc.js",
        "content/player/core.js",
        "content/player/guard.js",
        "content/player/index.js",
        "content/quiz.js",
        "content/section/core.js",
        "content/section/finder.js",
        "content/section/runner.js",
        "content/section/index.js",
        "content/interceptor.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_appName__"
  }
}